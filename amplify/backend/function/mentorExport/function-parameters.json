{
  "permissions": {
    "api": {
      "kiyanaw": [
        "Query",
        "Mutation",
        "Subscription"
      ]
    },
    "storage": {
      "transcriptions": [
        "create",
        "read",
        "update"
      ],
      "Transcription:@model(appsync)": [
        "read"
      ],
      "Region:@model(appsync)": [
        "read"
      ],
      "Media:@model(appsync)": [
        "read"
      ],
      "Export:@model(appsync)": [
        "create",
        "read",
        "update"
      ]
    }
  },
  "lambdaLayers": [
    {
      "type": "ProjectLayer",
      "resourceName": "kiyanawffmpeg",
      "version": "Always choose latest version",
      "isLatestVersionSelected": true,
      "env": "staging"
    }
  ]
}
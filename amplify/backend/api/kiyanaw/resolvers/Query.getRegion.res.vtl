## Response mapping template for Query.getRegion (data function slot)
## Stashes the fetched Region so the subsequent GetRegionTranscriptionACLFn can use it.
## ACL enforcement (parent Transcription isPrivate check) is handled by that pipeline function.

#set($region = $ctx.result)
#if($util.isNull($region))
  $util.qr($ctx.stash.put("regionNull", true))
  $util.qr($ctx.stash.put("fetchedItem", null))
#else
  $util.qr($ctx.stash.put("regionNull", false))
  $util.qr($ctx.stash.put("fetchedItem", $region))
#end
$util.toJson($region)
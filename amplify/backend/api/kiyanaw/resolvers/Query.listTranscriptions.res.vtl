## Response mapping template for Query.listTranscriptions
## Filters items based on isPrivate dynamic authorization

#set($out = [])
#set($userSub = $ctx.identity.claims.get("sub"))
#set($userGroups = $ctx.identity.claims.get("cognito:groups"))

## Default userSub and userGroups to empty if null
#if($util.isNull($userSub))
  #set($userSub = "")
#end
#if($util.isNull($userGroups))
  #set($userGroups = [])
#end

#foreach($item in $ctx.result.items)
  #set($ok = false)

  #if($item.isPrivate == true)
    ## PRIVATE item - check ACLs
    #set($editOk = false)
    #set($viewOk = false)
    
    ## Check editor access
    #if(!$util.isNull($item.editorGroups) && $util.list.copyAndRetain($item.editorGroups, $userGroups).size() > 0)
      #set($editOk = true)
    #end
    #if(!$util.isNull($item.editors) && $item.editors.contains($userSub))
      #set($editOk = true)
    #end
    
    ## Check viewer access
    #if(!$util.isNull($item.viewerGroups) && $util.list.copyAndRetain($item.viewerGroups, $userGroups).size() > 0)
      #set($viewOk = true)
    #end
    #if(!$util.isNull($item.viewers) && $item.viewers.contains($userSub))
      #set($viewOk = true)
    #end
    
    #if($editOk || $viewOk)
      #set($ok = true)
    #end
  #else
    ## PUBLIC item - any authenticated user
    #if(!$util.isNullOrEmpty($userSub))
      #set($ok = true)
    #end
  #end

  #if($ok)
    $util.qr($out.add($item))
  #end
#end

$util.toJson({
  "items": $out,
  "nextToken": $ctx.result.nextToken
}) 
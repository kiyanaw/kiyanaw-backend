{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Attach appsync:GraphQL permission to Cognito Identity Pool roles",
  "Parameters": {
    "authRoleName": {
      "Type": "String"
    },
    "unauthRoleName": {
      "Type": "String"
    },
    "AppSyncApiId": {
      "Type": "String"
    }
  },
  "Resources": {
    "GraphQLAuthRolePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "GraphQLAuthRolePolicy",
        "Roles": [
          { "Ref": "authRoleName" }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [ "appsync:GraphQL" ],
              "Resource": {
                "Fn::Sub": "arn:aws:appsync:${AWS::Region}:${AWS::AccountId}:apis/${AppSyncApiId}/*"
              }
            }
          ]
        }
      }
    },
    "GraphQLUnauthRolePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "GraphQLUnauthRolePolicy",
        "Roles": [
          { "Ref": "unauthRoleName" }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [ "appsync:GraphQL" ],
              "Resource": {
                "Fn::Sub": "arn:aws:appsync:${AWS::Region}:${AWS::AccountId}:apis/${AppSyncApiId}/*"
              }
            }
          ]
        }
      }
    }
  }
} 